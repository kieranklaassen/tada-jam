{
  "name": "tada-jam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run lab:publish",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "egress:check": "node scripts/egress-check.ts",
    "egress:built": "node scripts/egress-check.ts --built",
    "wordless:check": "node scripts/wordless-check.ts",
    "new:game": "node scripts/new-game.ts",
    "serve:lan": "npm run build && vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "perf:pebble": "node scripts/pebble-perf.mjs",
    "perf:pebble-scale": "node scripts/pebble-scale-probe.mjs",
    "perf:jam": "node scripts/jam-perf.mjs",
    "check:intersections": "node scripts/jam-intersections.mjs",
    "lab:dev": "vite --config lab/vite.config.ts",
    "lab:typecheck": "tsc --noEmit -p lab/tsconfig.json",
    "lab:test": "vitest run --config lab/vitest.config.ts",
    "lab:build": "vite build --config lab/vite.config.ts",
    "lab:serve": "vite build --config lab/vite.config.ts && vite preview --config lab/vite.config.ts --host 0.0.0.0 --port 4174 --strictPort",
    "lab:publish": "vite build --config lab/vite.config.ts --outDir ../dist/lab --emptyOutDir",
    "lab:check": "npm run lab:typecheck && npm run lab:test",
    "lab:catalog": "node lab/ideas/render.ts",
    "lab:panel": "node lab/panel/run.ts",
    "lab:report": "node lab/panel/report.ts",
    "lab:smoke": "node lab/smoke.mjs",
    "education:typecheck": "tsc --noEmit -p education/tsconfig.json",
    "education:test": "vitest run --config education/vitest.config.ts",
    "education:check": "npm run education:typecheck && npm run education:test",
    "education:built": "node education/tools/built-check.ts",
    "education:validate": "node education/tools/validate.ts",
    "education:fetch": "node education/tools/fetch.ts",
    "education:overlap": "node education/tools/overlap.ts",
    "education:reuse-history": "node education/tools/reuse-history.ts",
    "education:lint-notes": "node education/tools/validate.ts --complete",
    "education:import": "node education/tools/import.ts",
    "education:extract": "node education/tools/extract.ts",
    "education:frame-texts": "node education/tools/frame-texts.ts",
    "education:frames": "node education/tools/frames.ts",
    "education:lane-text": "node education/tools/lane-text.ts",
    "education:match": "node education/tools/match.ts",
    "education:verify": "node education/tools/review-join.ts",
    "education:gate": "node education/tools/gate.ts",
    "education:tree": "node education/tools/gate.ts --no-store",
    "education:coverage": "node education/tools/coverage.ts",
    "education:find": "node education/tools/lookup.ts",
    "check": "npm run typecheck && npm run test && npm run egress:check && npm run wordless:check"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@dimforge/rapier3d-simd-compat": "^0.20.0",
    "@fontsource/albert-sans": "^5.3.0",
    "@react-three/fiber": "^9.8.0",
    "@react-three/postprocessing": "^3.1.2",
    "cannon-es": "^0.20.0",
    "matter-js": "0.20.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "playwright": "1.63.0",
    "three-mesh-bvh": "^0.9.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
