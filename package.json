{
  "name": "tada-jam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "egress:check": "node scripts/egress-check.ts",
    "egress:built": "node scripts/egress-check.ts --built",
    "wordless:check": "node scripts/wordless-check.ts",
    "serve:lan": "vite build && vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "perf:pebble": "node scripts/pebble-perf.mjs",
    "perf:jam": "node scripts/jam-perf.mjs",
    "check:intersections": "node scripts/jam-intersections.mjs",
    "check": "npm run typecheck && npm run test && npm run egress:check && npm run wordless:check"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.0",
    "@react-three/postprocessing": "^3.1.2",
    "cannon-es": "^0.20.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "playwright": "1.63.0",
    "three-mesh-bvh": "^0.9.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
